#!/bin/bash
# First-boot bootstrap: all real configuration is done by Ansible.
# (Systems Manager runs the same playbooks later for deployments and drift correction.)
set -euo pipefail

dnf install -y ansible-core

mkdir -p /opt/ansible
aws s3 sync "s3://${artifacts_bucket}/ansible/" /opt/ansible/ --exclude vars.yml --region "${region}"
aws s3 cp "s3://${artifacts_bucket}/config/vars.yml" /opt/ansible/vars.yml --region "${region}"

cd /opt/ansible
ansible-playbook -i localhost, -c local site.yml -e @vars.yml
